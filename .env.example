# Buddy TTS configuration
# Copy this file to .env and fill in your values:
#   cp ~/.buddy-tts/.env.example ~/.buddy-tts/.env

# TTS engine: "macos" (built-in, no account needed) or "fish" (Fish.audio API)
TTS_ENGINE=macos

# macOS TTS settings (only used when TTS_ENGINE=macos)
# Run `say -v '?'` to list available voices. Leave blank to use system default.
MACOS_VOICE=

# Fish.audio settings (only used when TTS_ENGINE=fish)
# Sign up and get your API key at: https://fish.audio
FISH_API_KEY=
# Voice model ID from Fish.audio (the "reference_id" shown on the voice page)
FISH_VOICE_ID=

# How often to poll the terminal for new speech bubbles (seconds)
POLL_INTERVAL=0.3
